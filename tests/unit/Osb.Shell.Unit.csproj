<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side unit tests for the freestanding line editor / completion.
       Links the real shell sources (LineEditor, Completion, Commands, History)
       and replaces only the INT 21h layer with StubSyscall (scripted input +
       a fake ext4 directory). No QEMU, no NativeAOT: runs in <1 s. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OsbShellUnit</AssemblyName>
    <RootNamespace>Osb.Shell.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8597;CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../LineEditor.cs" Link="LineEditor.cs" />
    <Compile Include="../../Completion.cs" Link="Completion.cs" />
    <Compile Include="../../Commands.cs" Link="Commands.cs" />
    <Compile Include="../../History.cs" Link="History.cs" />
  </ItemGroup>

</Project>
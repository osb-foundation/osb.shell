<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableImplicitUsings>true</DisableImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <UseAppHost>false</UseAppHost>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <AssemblyName>TOslangEntry</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../../osbkt/Syscall.cs" Link="osbkt/Syscall.cs" />
    <Compile Include="../../../../osbkt/Fmt.cs" Link="osbkt/Fmt.cs" />
    <Compile Include="../../../../osb.core/src/*.cs" Link="osb.core/%(Filename)%(Extension)" />
    <!-- O8.24 M3: OsbMemoryProvider (the real OSLANG memory provider) is linked
         from osb.oslang as linked sources, exactly like TMemProvider does. EngineHeap
         cannot be linked here: its type graph pulls in the full OSLANG object
         model/compiler (Value -> AstNodes/Math), which is hosted-GC based and
         lives in osb.oslang. EngineHeap is initialized in the OSLANG runtime
         (OsbMain.cs); this test initializes its foundation, OsbMemoryProvider,
         directly over the kernel-validated process-owned heap region. -->
    <Compile Include="../../../../osb.oslang/engine/Core/Providers/OsbMemoryProvider.cs" Link="osb.oslang/Providers/OsbMemoryProvider.cs" />
    <Compile Include="../../../../osb.oslang/engine/Core/Providers/IMemoryProvider.cs" Link="osb.oslang/Providers/IMemoryProvider.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Target Name="CheckSiblings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../../../osbkt/Syscall.cs')"
           Text="osbkt sibling repo not found. Clone the OSB repos side by side; see ../../README.md." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../../../osb.core/src/MiniCoreLib.cs')"
           Text="osb.core sibling repo not found. Clone the OSB repos side by side; see ../../README.md." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../../../osb.oslang/engine/Core/Providers/OsbMemoryProvider.cs')"
           Text="osb.oslang engine Core not found. Clone the OSB repos side by side; see ../../README.md." />
  </Target>

  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>

</Project>
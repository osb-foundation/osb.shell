<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableImplicitUsings>true</DisableImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <UseAppHost>false</UseAppHost>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <AssemblyName>OsbShell</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- osbkt + osb.core are consumed by linked sources (no DLLs at runtime):
         the syscall wrappers and the canonical MiniCoreLib compile straight
         into SHELL.EXE. Sibling checkout required (A10). -->
    <Compile Include="../osbkt/Syscall.cs" Link="osbkt/Syscall.cs" />
    <Compile Include="../osbkt/Fmt.cs" Link="osbkt/Fmt.cs" />
    <Compile Include="../osb.core/src/MiniCoreLib.cs" Link="MiniCoreLib.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Program.Commands.cs" />
    <Compile Include="Program.Users.cs" />
    <Compile Include="Program.Tasks.cs" />
    <Compile Include="Env.cs" />
    <Compile Include="External.cs" />
    <Compile Include="FileCommands.cs" />
    <Compile Include="LineEditor.cs" />
    <Compile Include="History.cs" />
    <Compile Include="Commands.cs" />
    <Compile Include="HelpText.cs" />
    <Compile Include="Session.cs" />
    <Compile Include="Login.cs" />
    <Compile Include="Completion.cs" />
  </ItemGroup>

  <!-- Fail with a clear message when a sibling repo is missing (A10). -->
  <Target Name="CheckSiblings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../osbkt/Syscall.cs')"
           Text="osbkt sibling repo not found (expected ../osbkt/Syscall.cs). Clone the OSB repos side by side; see README.md." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../osb.core/src/MiniCoreLib.cs')"
           Text="osb.core sibling repo not found (expected ../osb.core/src/MiniCoreLib.cs). Clone the OSB repos side by side; see README.md." />
  </Target>

  <!-- Same as kernel: strip out unnecessary .NET references -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>
</Project>